# ==============================================================================
# MODELO DE CONFIGURAÇÃO DE SEGREDOS (STREAMLIT SECRETS)
# ==============================================================================
# Para uso local: copie este arquivo para ".streamlit/secrets.toml" e preencha as chaves.
# Para deploy no Streamlit Cloud: copie e cole estas variáveis na seção "Secrets" do app.

# 1. Provedor Google AI Studio (Gemini)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY = ""

# 2. Provedor Palantir Foundry / Azure OpenAI / OpenAI compatível (Opcional)
FOUNDRY_API_KEY = ""
FOUNDRY_ENDPOINT = "https://seu-endpoint.com/v1"
FOUNDRY_MODEL = "gpt-4o-mini"

# 3. Provedor Local (Ollama)
# Por padrão conecta em http://localhost:11434 e não requer chave de autenticação.
